    {
      "name": "Transaction history",
      "item": [
        {
          "name": "All transactions",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('has content array', () => pm.expect(pm.response.json().content).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/transactions",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "transactions" ]
            }
          }
        },
        {
          "name": "By date range",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/transactions?from=2026-01-01&to=2026-12-31",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "transactions" ],
              "query": [
                { "key": "from", "value": "2026-01-01" },
                { "key": "to", "value": "2026-12-31" }
              ]
            }
          }
        },
        {
          "name": "By month",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/transactions?month=2026-09",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "transactions" ],
              "query": [
                { "key": "month", "value": "2026-09" }
              ]
            }
          }
        },
        {
          "name": "Paged (size 1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('page size is 1', () => pm.expect(pm.response.json().size).to.eql(1));"
                ]
