                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nickname\": \"My own account\",\n  \"accountNumber\": \"ACC1001\"\n}"
