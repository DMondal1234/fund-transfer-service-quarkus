                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nickname\": \"Ghost\",\n  \"accountNumber\": \"ACC9999\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/beneficiaries",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "beneficiaries" ]
            }
          }
        },
        {
          "name": "Add beneficiary with blank fields (expect 400 validation)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('has validation details', () => pm.expect(pm.response.json().details.length).to.be.above(0));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nickname\": \"\",\n  \"accountNumber\": \"\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/beneficiaries",
              "host": [ "{{baseUrl}}" ],
