        {
          "name": "Update beneficiary 1 nickname",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('nickname updated', () => pm.expect(pm.response.json().nickname).to.eql('Bob (best friend)'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nickname\": \"Bob (best friend)\",\n  \"accountNumber\": \"ACC2001\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/beneficiaries/1",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "beneficiaries", "1" ]
            }
          }
        }
      ]
    },
    {
      "name": "Transfers",
      "item": [
        {
          "name": "Transfer 300 ACC1001 -> beneficiary 1 (expect 201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const t = pm.response.json();",
                  "pm.test('status SUCCESS', () => pm.expect(t.status).to.eql('SUCCESS'));",
                  "pm.test('source debited', () => pm.expect(Number(t.sourceBalanceAfter)).to.eql(4700));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceAccountNumber\": \"ACC1001\",\n  \"beneficiaryId\": 1,\n  \"amount\": 300.00,\n  \"description\": \"rent\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/transfers",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "transfers" ]
            }
          }
        },
        {
          "name": "Transfer more than balance (expect 422)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 422', () => pm.response.to.have.status(422));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceAccountNumber\": \"ACC1001\",\n  \"beneficiaryId\": 1,\n  \"amount\": 999999.00,\n  \"description\": \"too much\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/transfers",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "transfers" ]
            }
          }
        },
